# NestJS Controller Generation Pattern

Use this as the canonical pattern when creating/updating API controllers. Do not inspect other files.

## Required Structure

- Class decorators order: `@ApiTags` -> `@Controller(AppRoutesEnum.<ROUTE>)`.
- Constructor injects module service first, others next and `CacheService` last.
- Handlers stay thin: call service, clear cache on mutations, return typed response.
- Create DTO `*.dto.ts` files if needed (follow nestjs-dto-generation.mdc rule)
- Create filter `*.filter.ts` files if needed (follow nestjs-filter-generation.mdc rule)
- Create response `*.response.ts` files if needed (follow nestjs-response-generation.mdc rule)

## Required Endpoints Pattern

- `create`: `@Post()`, `@AppAuth({ permission: { action: ActionsEnum.CREATE } })`, `@ApiCreatedResponse`, clear cache.
- `findAll`: `@Post('all')`, `@AppAuth({ permission: { action: ActionsEnum.GET } })`, `@AppCache()`, `@ApiOkResponse`, optional `@ApiBody({ required: false, type: <Filter> })`.
- `update`: `@Patch()`, `@AppAuth({ permission: { action: ActionsEnum.UPDATE } })`, `@ApiOkResponse`, clear cache (+ dependent route keys when needed).
- `delete`: `@Delete(':<id_param>')`, `@AppAuth({ permission: { action: ActionsEnum.DELETE } })`, `@ApiOkResponse`, clear cache (+ dependent route keys when needed).

## Controller Template

```typescript
@ApiTags('<Plural Name>')
@Controller(AppRoutesEnum.<MODULE_ROUTE>)
export class <ModuleController> {
  constructor(
    private readonly <moduleService>: <ModuleService>,
    private readonly cacheService: CacheService,
  ) {}

  @AppAuth({ permission: { action: ActionsEnum.CREATE } })
  @ApiOperation({ summary: '<create summary>' })
  @ApiCreatedResponse({ description: '<create ok>', type: Status<Module>Response })
  @Post()
  async create(@Body() data: Create<Module>Dto): Promise<Status<Module>Response> {
    const result = await this.<moduleService>.create(data)
    await this.clearCache()
    return result
  }

  @AppAuth({ permission: { action: ActionsEnum.GET } })
  @AppCache()
  @ApiOperation({ summary: '<list summary>' })
  @ApiOkResponse({ description: '<list ok>', type: Array<Module>Response })
  @ApiBody({ required: false, type: <Module>Filter })
  @Post('all')
  async findAll(@Body() filter?: <Module>Filter): Promise<Array<Module>Response> {
    return await this.<moduleService>.findAll(filter)
  }

  @AppAuth({ permission: { action: ActionsEnum.UPDATE } })
  @ApiOperation({ summary: '<update summary>' })
  @ApiOkResponse({ description: '<update ok>', type: Status<Module>Response })
  @Patch()
  async update(@Body() data: Update<Module>Dto): Promise<Status<Module>Response> {
    const result = await this.<moduleService>.update(data)
    await this.clearCache([AppRoutesEnum.<DEPENDENT_ROUTE>])
    return result
  }

  @AppAuth({ permission: { action: ActionsEnum.DELETE } })
  @ApiOperation({ summary: '<delete summary>' })
  @ApiOkResponse({ description: '<delete ok>', type: Status<Module>Response })
  @Delete(':<id_param>')
  async delete(@Param() params: <Module>UniqueParams): Promise<Status<Module>Response> {
    const result = await this.<moduleService>.delete(params.<id_param>)
    await this.clearCache([AppRoutesEnum.<DEPENDENT_ROUTE>])
    return result
  }

  async clearCache(addKeys: AppRoutesEnum[] = []): Promise<void> {
    await this.cacheService.delete([AppRoutesEnum.<MODULE_ROUTE>, ...addKeys])
  }
}
```
