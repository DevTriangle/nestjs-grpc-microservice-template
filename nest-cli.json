{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.proto", "watchAssets": true },
      { "include": "i18n/**/*", "watchAssets": true, "outDir": "dist" }
    ],
    "watchAssets": true
  }
}
